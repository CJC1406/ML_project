.venv/
__pycache__/
.pytest_cache/
*.py[cod]

data/raw/*
data/processed/*
reports/generated/*
data/private/*
!data/raw/.gitkeep
!data/private/.gitkeep

experiments/*
!experiments/.gitkeep
models/*
!models/.gitkeep
dist/
build/
*.egg-info/
.DS_Store

# KNN model is ~25 MB; regenerate with scripts/knn/run_knn.py
results/knn/knn_model.joblib

results/knn_tuned/knn_model.joblib
results/ensemble/*.joblib

# Exported serving bundle is committed (the backend needs it); only the large training dump stays ignored.
!models/pathsnap_v1/
# Only the chosen ensemble's OOF probabilities are read (by scripts/hmm/run_hmm.py); the rest are regenerated by compare_all_models.py.
results/ensemble/*_train_oof_probs.npz
!results/ensemble/stacking_train_oof_probs.npz
